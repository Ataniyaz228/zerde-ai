# Environment Configuration (Шаблон для OpenRouter)
OPENAI_API_KEY=sk-or-v1-YOUR_OPENROUTER_API_KEY_HERE

# ─── Web Search Configuration (Провайдеры: tavily, serper, google, duckduckgo) ────────────────
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=tvly-YOUR_TAVILY_API_KEY_HERE
SERPER_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Для OpenRouter используй этот base URL:
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Для обычного OpenAI: https://api.openai.com/v1

# ─── LLM Settings ────────────────────────────────────────────────────────────
# Рекомендации OpenRouter:
#   moonshotai/kimi-k2.5           — лучший баланс цена/качество для длинных текстов
#   deepseek/deepseek-r1-distill-llama-70b — мощный reasoning
#   deepseek/deepseek-chat         — v3, быстрый и дешёвый
#   openai/gpt-4o                  — если есть бюджет
LLM_MODEL_PLANNER=openai/gpt-5-nano
LLM_MODEL_EXTRACTOR=openai/gpt-5-nano
LLM_MODEL_ANALYST=deepseek/deepseek-v4-pro
LLM_MODEL_POLICY_ANALYST=openai/gpt-5-nano
LLM_MAX_TOKENS_PLANNER=4096
LLM_MAX_TOKENS_ANALYST=8192

# ─── Embeddings (Опционально) ────────────────────────────────────────────────
# OpenRouter не поддерживает embeddings. 
# Если хочешь семантическую дедупликацию, введи ключ от обычного OpenAI здесь.
# Если оставить пустым — cosine_similarity отключится (останется только SHA256).
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ─── OpenRouter Headers (Для отслеживания в Dashboard) ───────────────────────
OPENROUTER_SITE_URL=https://github.com/zerde
OPENROUTER_APP_NAME=ZERDE_v6.2

# ─── Adilet Agent ────────────────────────────────────────────────────────────
ADILET_BASE_URL=https://adilet.zan.kz
ADILET_TIMEOUT_SECONDS=30
ADILET_MAX_ARTICLES_PER_LAW=50

# ─── Web Agent ───────────────────────────────────────────────────────────────
WEB_MAX_RESULTS_PER_QUERY=10

# ─── Fusion / Dedup ──────────────────────────────────────────────────────────
COSINE_SIMILARITY_THRESHOLD=0.92

# ─── Auditor / BM25 ──────────────────────────────────────────────────────────
VALIDATION_THRESHOLD=0.35
BM25_MEDIUM_THRESHOLD=0.15

# ─── Web-бэкенд (FastAPI) ────────────────────────────────────────────────────
# Общий API-ключ. Пусто/не задан — аутентификация выключена (только для dev!).
# На проде задай непустое значение: все /api-запросы потребуют заголовок
# X-API-Key. Фронт передаёт его через NEXT_PUBLIC_API_KEY.
ZERDE_API_KEY=
# Rate-limit запуска анализа: N запусков с одного IP за окно (секунды). 0 = выкл.
ZERDE_ANALYZE_RATE_LIMIT=10
ZERDE_ANALYZE_RATE_WINDOW_S=3600
# Разрешённые источники CORS (через запятую). На проде — домен фронта.
ZERDE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Лимит размера загружаемого файла, МБ.
ZERDE_MAX_UPLOAD_MB=25

# ─── Сессионная авторизация (логин по паролю) ─────────────────────────────────
# Секрет подписи JWT. Пусто/не задан — авторизация ВЫКЛючена (/api/* открыты).
# На проде сгенерируй: python -c "import secrets; print(secrets.token_hex(32))"
ZERDE_AUTH_SECRET=
# Срок жизни сессии в секундах (по умолчанию 7 дней).
ZERDE_AUTH_SESSION_TTL_S=604800
# Secure-cookie: 1 — только по HTTPS (прод). Для локального http-дева — 0.
ZERDE_AUTH_COOKIE_SECURE=1
# Пользователи заводятся через: cd web/backend && ../../.venv/bin/python manage.py create-user <логин>
